{
  "name": "deplo",
  "version": "0.6.0-canary.36",
  "deplo": {
    "agent": "0.5.1-canary.10",
    "agentMin": "0.4.0"
  },
  "license": "AGPL-3.0-only",
  "private": true,
  "scripts": {
    "dev": "node scripts/third-party-notices.mjs && next dev",
    "build": "node scripts/third-party-notices.mjs && next build",
    "prod": "bun run build && next start",
    "start": "NODE_OPTIONS=--max-semi-space-size=64 next start",
    "lint": "eslint",
    "build:recover": "node scripts/build-recover.mjs",
    "recover": "node --require ./lib/test/server-only-shim.cjs --import tsx scripts/recover.ts",
    "usage-report:send": "node --require ./lib/test/server-only-shim.cjs --import tsx scripts/usage-report-send.ts",
    "gen:schema": "NODE_TEST_CONTEXT=1 node --require ./lib/test/server-only-shim.cjs --import tsx scripts/gen-schema.ts",
    "test": "node scripts/test.mjs",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
