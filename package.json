{
  "name": "deplo",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "prod": "next build && next start",
    "start": "next start",
    "lint": "eslint",
    "recover": "node --require ./lib/test/server-only-shim.cjs --import tsx scripts/recover.ts",
    "gen:schema": "NODE_TEST_CONTEXT=1 node --require ./lib/test/server-only-shim.cjs --import tsx scripts/gen-schema.ts",
    "test": "node --require ./lib/test/server-only-shim.cjs --import tsx --test --test-concurrency=2 \"lib/**/*.test.ts\" \"components/**/*.test.ts\" \"*.test.ts\"",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "dependencies": {
    "@better-auth/oauth-provider": "1.7.2",
