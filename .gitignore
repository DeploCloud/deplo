# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases 
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example


# typescript
*.tsbuildinfo
next-env.d.ts

# Deplo dev build/upload staging dir (DEPLO_DATA_DIR; not a data store)
/.deplo/
.claude

# this is a bun project (bun.lock is the tracked lockfile); never an npm lockfile
/package-lock.json
# Local control-plane run log (see docs/agents/fleet-rollout.md)
control-plane.log

# Audit report work file (not versioned)
DEPLO_TEST_OPUS.md
DEPLO_TEST_FABLE.md

# Security assessment work files. These name live function paths and, in the case
# of the scratch exploit, contain a working proof of concept. They stay out of a
# public tree; the copy lives outside the repo.
SECURITY_AUDIT.md
inj-scratch.ts

# Migration scratch dir. It holds a live API token, is untracked, and used to be
# unignored - one `git add -A` away from being published.
/.tmp-mig/
