# Deplo configuration. Copy to .env and fill in for local/production use.

# Root secret. REQUIRED in production. Derives all session signing and
# AES-256-GCM encryption keys, and is reused as the Better Auth secret.
# Generate one with: openssl rand -base64 48
DEPLO_SECRET=

# Public URL the dashboard is served from (used for cookies, TLS detection and
# the install command). Example: https://deplo.example.com
DEPLO_PUBLIC_URL=

# One-click template catalog. Optional: defaults to Deplo's public catalog.
# Set it to mirror the catalog yourself. Example: https://templates.example.com
DEPLO_TEMPLATES_API_URL=

# Public IPv4 of this server. Embedded into the zero-config sslip.io hostnames
# (<app>.<ip>.sslip.io) and the Traefik Host() router rule for every deployment,
# so it MUST be a literal, internet-reachable IPv4, not a hostname. install.sh
# detects and sets this automatically; set it by hand for manual/dev runs.
# If unset, Deplo auto-detects the first non-internal NIC address and only falls
# back to 127.0.0.1 (which makes generated URLs reachable from this machine
# only) as a last resort. Example: 203.0.113.10
DEPLO_SERVER_IP=

# Enrollment of the machine Deplo runs on as a server ("agent 0"), so a fresh
# install has somewhere to deploy to without anyone opening a shell. install.sh
# generates the token, writes it here and hands the SAME one to the agent
# installer on the host; Deplo arms a one-time bootstrap on its own server row
# with it, and the agent claims it by calling home. Unset means "do not enroll" -
# which is what a dev run wants. Generate one with: openssl rand -base64 32
DEPLO_HOST_BOOTSTRAP_TOKEN=

# Gate on the first-run setup wizard. Without it the first account - which is the
# instance owner and admin - is created by whoever reaches /setup first, and the
# panel's address is derivable from the server's IP. install.sh generates one and
# prints the link; set it by hand for a manual install. It stops mattering once an
# account exists. Generate one with: openssl rand -hex 8
DEPLO_SETUP_KEY=

# Name shown on that server's card. install.sh passes the host's own `hostname`,
# which Deplo cannot read for itself: it runs in a container, where the hostname
# is a random container id. Falls back to DEPLO_SERVER_IP.
DEPLO_HOST_NAME=

# Postgres connection string. REQUIRED - PostgreSQL is Deplo's only
# control-plane data store and also backs Better Auth. The app fails fast at
# startup if this (or DATABASE_URL) is unset; there is no file-based fallback.
# Example: postgres://deplo:password@localhost:5432/deplo
DEPLO_DATABASE_URL=

# Optional: cap the Postgres connection pool size (default 10).
# DEPLO_DATABASE_POOL_MAX=10

# Email used for Let's Encrypt certificates in the generated installer.
DEPLO_ACME_EMAIL=

# Name of the Traefik ACME cert resolver baked into every deployment's router
# `tls.certresolver` label. Defaults to `letsencrypt`. sslip.io domains require
# an HTTP-01 resolver (they cannot pass DNS-01 - sslip.io's DNS is not ours to
# edit); if your Traefik's default resolver uses DNS-01 (e.g. Cloudflare for a
# real domain), define a separate HTTP-01 resolver in Traefik and set its name
# here so sslip.io certs issue instead of serving Traefik's self-signed default.
# DEPLO_CERT_RESOLVER=letsencrypt

# Host-visible directory used for build/upload staging that the Docker daemon
# must be able to see (NOT a data store - all control-plane data lives in
# Postgres). Defaults to /data in the container, ./.deplo in local dev.
# DEPLO_DATA_DIR=./.deplo
